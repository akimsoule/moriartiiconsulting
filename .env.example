# Database
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# Site Configuration
NEXT_PUBLIC_SITE_URL="https://moriartiiconsulting.com"

# Google Services
GOOGLE_SITE_VERIFICATION="your-google-site-verification-code"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# JWT
JWT_SECRET="your-jwt-secret"

# Email Configuration (if needed)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# MCP Connector (OAuth 2.1) — voir GUIDE-MCP-AFIZ.md
# Émetteur OAuth public du site (sans slash final)
OAUTH_ISSUER="https://www.moriartiiconsulting.org"
# SHA-256 (hex) du code personnel du propriétaire — jamais le code en clair
MCP_OWNER_CODE_HASH="votre-sha256-du-code-personnel"
# Id du User auquel attribuer les articles créés via MCP (optionnel :
# repli sur le compte administrateur si absent)
MCP_AUTHOR_ID="id-utilisateur-auteur"
